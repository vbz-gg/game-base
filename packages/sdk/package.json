{
  "name": "@vbz-gg/sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "Build a game that runs on vbz.gg: on-screen controls, the two artifacts, and a harness that frames your game the way production does",
  "license": "MIT",
  "author": "Ramesh Nair",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbz-gg/sdk.git",
    "directory": "packages/sdk"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "templates",
    "README.md"
  ],
  "exports": {
    "./controls": {
      "development": "./src/controls/index.ts",
      "types": "./dist/controls/index.d.ts",
      "default": "./dist/controls/index.js"
    },
    "./build": {
      "development": "./src/build/index.ts",
      "types": "./dist/build/index.d.ts",
      "default": "./dist/build/index.js"
    },
    "./serve": {
      "development": "./src/serve/index.ts",
      "types": "./dist/serve/index.d.ts",
      "default": "./dist/serve/index.js"
    },
    "./harness": {
      "development": "./src/harness/index.ts",
      "types": "./dist/harness/index.d.ts",
      "default": "./dist/harness/index.js"
    }
  },
  "peerDependencies": {
    "@clockwork2/engine": ">=0.8.0 <0.9.0"
  },
  "bin": {
    "vbz": "./dist/cli/index.js"
  }
}
