{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    // `cw2:sim` is not resolvable by a browser and is not meant to be: the
    // host rewrites it to the simulation's content address at publish. For
    // typechecking it points at the simulation's own source, which is the
    // module it will resolve to.
    "paths": { "cw2:sim": ["./src/sim/index.ts"] }
  },
  "include": ["src"]
}
